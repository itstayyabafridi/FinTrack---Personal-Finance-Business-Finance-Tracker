rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.email is string && data.email.size() <= 255 &&
             data.fullName is string && data.fullName.size() <= 150 &&
             (!('role' in data) || data.role in ['owner', 'admin', 'member']);
    }

    function isValidTransaction(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.description is string && data.description.size() <= 255 &&
             data.amount is number &&
             data.type is string &&
             data.paymentMethod is string;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data) &&
                      request.resource.data.userId == resource.data.userId;
      allow delete: if false;

      match /transactions/{txId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(txId) && isValidTransaction(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidId(txId) && isValidTransaction(request.resource.data, userId) &&
                        request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId) && isValidId(txId);
      }
    }
  }
}
