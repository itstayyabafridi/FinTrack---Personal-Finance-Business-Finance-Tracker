# FinTrack Environment Variables
# Copy this to .env and fill in your values

# =============================================
# Required for Manus OAuth Authentication
# =============================================
VITE_OAUTH_PORTAL_URL=https://manus.computer
VITE_APP_ID=your-app-id

# =============================================
# Required for Google Maps (via Forge Proxy)
# =============================================
VITE_FRONTEND_FORGE_API_KEY=your-forge-api-key
VITE_FRONTEND_FORGE_API_URL=https://forge.butterfly-effect.dev

# =============================================
# Optional: Analytics (Umami)
# =============================================
# VITE_ANALYTICS_ENDPOINT=https://your-analytics.example.com
# VITE_ANALYTICS_WEBSITE_ID=your-website-id

# =============================================
# Server-side (for production)
# =============================================
# BUILT_IN_FORGE_API_URL=https://forge.butterfly-effect.dev
# BUILT_IN_FORGE_API_KEY=your-forge-api-key

# =============================================
# Supabase (Required for backend)
# =============================================
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# =============================================
# Database (Supabase Postgres)
# =============================================
# DATABASE_URL=postgresql://user:password@localhost:5432/fintrack

# =============================================
# Session/Auth
# =============================================
# SESSION_SECRET=your-secure-random-secret
# JWT_SECRET=your-jwt-secret